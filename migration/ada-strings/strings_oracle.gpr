-- Builds the reference oracle from the unmodified legacy source.
project Strings_Oracle is
   for Languages use ("Ada");
   for Source_Dirs use (".", "../../src/latin_utils");
   for Source_Files use ("strings_oracle.adb",
                         "latin_utils.ads",
                         "latin_utils-strings_package.ads",
                         "latin_utils-strings_package.adb");
   for Object_Dir use "../build/ada";
   for Exec_Dir use "../build";
   for Main use ("strings_oracle.adb");

   package Compiler is
      for Default_Switches ("Ada") use ("-O2", "-gnat12");
   end Compiler;
end Strings_Oracle;
